#!/usr/bin/env bash
# Run as root on roguix.frolow.dev: import the newest release of a feed,
# so guix publish serves it.  The archive is signed with the builder key,
# modules/roguix/builder.pub, which the host must authorize;
# guix archive --import rejects anything else.
#
#   scripts/vps-import [-p PREFIX] [TAG]
#   scripts/vps-import --static-dir DIR --key PUBLIC_KEY [-p PREFIX] [--keep N] [TAG]
# Static mode requires static-tree and verify-substitutes.scm alongside
# this script, Python 3.11+, and Guix. Without --keep, it deletes nothing.
#
# PREFIX names the reference-system feed: x86_64-desktop (default)
# or aarch64-desktop. Archive import and
# substitution of explicit store paths work across architectures.
# A TAG names its feed itself:
# PREFIX-DATE-COMMIT-ATTEMPT.
set -euo pipefail
# Static mode is opt-in; the historical archive importer below is unchanged.
for arg in "$@"; do
  if [[ $arg == --static-dir ]]; then
    here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
    args=()
    while [[ $# -gt 0 ]]; do
      case $1 in
        --static-dir) args+=(--directory "${2:?--static-dir needs a directory}"); shift 2 ;;
        -p) args+=(--prefix "${2:?-p needs a feed prefix}"); shift 2 ;;
        *) args+=("$1"); shift ;;
      esac
    done
    exec python3 "$here/static-tree" pull "${args[@]}"
  fi
done
repo=roguixos/roguix
prefix=
if [ "${1:-}" = -p ]; then
  prefix=${2:?usage: scripts/vps-import [-p PREFIX] [TAG]}
  shift 2
fi
if [ -n "${1:-}" ]; then
  tag=$1
  prefix=${prefix:-${tag%-*-*-*}}
else
  prefix=${prefix:-x86_64-desktop}
  # A date follows the prefix, so the retired server feed's x86_64-DATE
  # tags never match.
  tag=$(curl -sf "https://api.github.com/repos/$repo/releases?per_page=100" |
    grep -o "\"tag_name\": *\"$prefix-[0-9][^\"]*\"" | head -1 | cut -d'"' -f4)
  [ -n "$tag" ] || { echo "vps-import: no $prefix release" >&2; exit 1; }
fi
archive=roguix-$prefix.nar.zst
dir=/var/cache/roguix-import/$tag
mkdir -p "$dir"
cd "$dir"
for f in "$archive" publish.txt; do
  [ -s "$f" ] || curl -sfL -o "$f" "https://github.com/$repo/releases/download/$tag/$f"
done
# GitHub cannot attach an empty asset. Both feeds permit an absent
# vps-fetch.txt, meaning no bordeaux items; other HTTP errors still fail.
if [ ! -f vps-fetch.txt ]; then
  code=$(curl -sSL -o vps-fetch.txt.tmp -w '%{http_code}' \
    "https://github.com/$repo/releases/download/$tag/vps-fetch.txt")
  case "$code" in
    200) mv vps-fetch.txt.tmp vps-fetch.txt ;;
    404) rm vps-fetch.txt.tmp; : > vps-fetch.txt ;;
    *) echo "vps-import: vps-fetch.txt HTTP $code" >&2; exit 1 ;;
  esac
fi

# guix archive --import needs every reference valid: take those from
# bordeaux first.
if [ -s vps-fetch.txt ]; then
  fetch=()
  while read -r item; do fetch+=("$item"); done < vps-fetch.txt
  nice -n 19 ionice -c3 guix build \
    --substitute-urls=https://bordeaux.guix.gnu.org "${fetch[@]}" > /dev/null
fi
zstd -dc "$archive" | nice -n 19 ionice -c3 guix archive --import

# Bake guix publish's cache one item at a time, so no client request
# starts compressing (it once hung this host).
while read -r item; do
  hash=$(basename "$item" | cut -d- -f1)
  for _ in $(seq 360); do
    code=$(curl -s -o /dev/null -w '%{http_code}' "http://127.0.0.1:8181/$hash.narinfo")
    [ "$code" = 200 ] && break
    sleep 5 # delay: poll until guix publish serves the baked item's narinfo
  done
  [ "$code" = 200 ] || echo "not baked: $item ($code)"
done < publish.txt
echo "imported $tag: $(wc -l < publish.txt) items"

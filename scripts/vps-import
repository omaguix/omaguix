#!/usr/bin/env bash
# Run as root on roguix.frolow.dev: import the newest release of a feed,
# so guix publish serves it.  The archive is signed with the builder key,
# modules/roguix/builder.pub, which the host must authorize;
# guix archive --import rejects anything else.
#
#   scripts/vps-import [-p PREFIX] [TAG]
#
# PREFIX names the feed: x86_64-desktop (the default and the only one
# left) is the Roguix desktop's (build-x86_64-desktop.yml,
# channels-desktop.scm).  A TAG names its feed itself:
# PREFIX-DATE-COMMIT-ATTEMPT.
set -euo pipefail
repo=roguixos/roguix
prefix=
if [ "${1:-}" = -p ]; then
  prefix=${2:?usage: scripts/vps-import [-p PREFIX] [TAG]}
  shift 2
fi
if [ -n "${1:-}" ]; then
  tag=$1
  prefix=${prefix:-${tag%-*-*-*}}
else
  prefix=${prefix:-x86_64-desktop}
  # A date follows the prefix, so the retired server feed's x86_64-DATE
  # tags never match.
  tag=$(curl -sf "https://api.github.com/repos/$repo/releases?per_page=100" |
    grep -o "\"tag_name\": *\"$prefix-[0-9][^\"]*\"" | head -1 | cut -d'"' -f4)
  [ -n "$tag" ] || { echo "vps-import: no $prefix release" >&2; exit 1; }
fi
archive=roguix-$prefix.nar.zst
dir=/var/cache/roguix-import/$tag
mkdir -p "$dir"
cd "$dir"
for f in "$archive" publish.txt vps-fetch.txt; do
  [ -s "$f" ] || curl -sfL -o "$f" "https://github.com/$repo/releases/download/$tag/$f"
done

# guix archive --import needs every reference valid: take those from
# bordeaux first.
if [ -s vps-fetch.txt ]; then
  nice -n 19 ionice -c3 guix build \
    --substitute-urls=https://bordeaux.guix.gnu.org $(cat vps-fetch.txt) > /dev/null
fi
zstd -dc "$archive" | nice -n 19 ionice -c3 guix archive --import

# Bake guix publish's cache one item at a time, so no client request
# starts compressing (it once hung this host).
while read -r item; do
  hash=$(basename "$item" | cut -d- -f1)
  for _ in $(seq 360); do
    code=$(curl -s -o /dev/null -w '%{http_code}' "http://127.0.0.1:8181/$hash.narinfo")
    [ "$code" = 200 ] && break
    sleep 5
  done
  [ "$code" = 200 ] || echo "not baked: $item ($code)"
done < publish.txt
echo "imported $tag: $(wc -l < publish.txt) items"

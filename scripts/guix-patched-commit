#!/usr/bin/env bash
# Commit the channel's pinned Guix G plus the channel's Guix patch as G', the
# Guix a release is built with (try-omaguix docs/decisions/0007).
#
#   scripts/guix-patched-commit REPO G PATCH
#
# REPO is a Git repository holding commit G (a shallow fetch is enough).
# G is the channel's pin, or the fork commit on top of it that
# scripts/guix-base names.
# Prints G'. The commit is made from G's tree and the patch only, with a
# fixed identity and G's committer date, so every architecture's runner
# makes the same G'. It fails unless reverting the patch from G' gives
# exactly G's tree.
set -euo pipefail
repo=${1:?usage: scripts/guix-patched-commit REPO G PATCH}
pin=${2:?usage: scripts/guix-patched-commit REPO G PATCH}
patch=$(cd "$(dirname "${3:?usage: scripts/guix-patched-commit REPO G PATCH}")" && pwd)/$(basename "$3")
[[ $pin =~ ^[0-9a-f]{40}$ ]] || { echo "guix-patched-commit: invalid Guix commit $pin" >&2; exit 1; }
# Git configuration (such as i18n.commitEncoding) must not change G'.
export GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null LC_ALL=C
[[ $(git -C "$repo" rev-parse --verify "$pin^{commit}") == "$pin" ]]

index=$(mktemp)
trap 'rm -f "$index"' EXIT
export GIT_INDEX_FILE=$index
git -C "$repo" read-tree "$pin"
git -C "$repo" apply --cached "$patch"
tree=$(git -C "$repo" write-tree)

sha256=$(sha256sum "$patch" | cut -d' ' -f1)
date=$(git -C "$repo" log -1 --format=%cI "$pin")
patched=$(GIT_AUTHOR_NAME="Omaguix CI" GIT_AUTHOR_EMAIL=ci@omaguix.org \
  GIT_COMMITTER_NAME="Omaguix CI" GIT_COMMITTER_EMAIL=ci@omaguix.org \
  GIT_AUTHOR_DATE=$date GIT_COMMITTER_DATE=$date \
  git -C "$repo" commit-tree "$tree" -p "$pin" \
    -m "Omaguix: apply guix-skip-forward-check.patch" \
    -m "Patch SHA-256: $sha256")

[[ $(git -C "$repo" rev-parse "$patched^") == "$pin" ]]
git -C "$repo" read-tree "$patched"
git -C "$repo" apply --cached -R "$patch"
if [[ $(git -C "$repo" write-tree) != $(git -C "$repo" rev-parse "$pin^{tree}") ]]; then
  echo "guix-patched-commit: $patched minus the patch is not $pin's tree" >&2
  exit 1
fi
echo "$patched"

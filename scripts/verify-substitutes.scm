;; The only protocol verifier: Guix parsing, a one-key ACL, and Guix's own
;; decompression/hash ports. With STATIC_TREE, also verify every advertised NAR.
(use-modules (guix narinfo) (guix pki) (guix store) (guix utils)
             (gcrypt hash) (gcrypt pk-crypto) (rnrs bytevectors)
             (ice-9 rdelim) (ice-9 binary-ports) (srfi srfi-1)
             (srfi srfi-13) (srfi srfi-71) (web uri))
;; As in (guix scripts authenticate), which does not export it.
(define read-canonical-sexp
  (compose string->canonical-sexp read-string))
(define public-key
  (call-with-input-file (getenv "STATIC_PUBLIC_KEY") read-canonical-sexp))
(define acl (public-keys->acl (list public-key)))
(when (getenv "STATIC_SECRET_KEY")
  (let* ((secret (call-with-input-file (getenv "STATIC_SECRET_KEY") read-canonical-sexp))
         (hash (sha256 (string->utf8 "Roguix substitute keypair check")))
         (data (bytevector->hash-data hash #:key-type (key-type public-key)))
         (signature (signature-sexp data secret public-key)))
    (signature-case (signature hash acl)
      (valid-signature #t)
      (else (error "secret does not match the authenticated guest key")))))

(define (check-nar info relative compression file-size)
  (when (getenv "STATIC_TREE")
    (let* ((file (string-append (getenv "STATIC_TREE") "/" relative))
           (raw (open-file file "rb"))
           (input pids (decompressed-port (string->symbol compression) raw))
           (algorithm expected (narinfo-hash-algorithm+value info))
           (hashed get-hash (open-hash-input-port algorithm input))
           (size (let loop ((size 0))
                   (let ((block (get-bytevector-n hashed 65536)))
                     (if (eof-object? block) size
                         (let ((size (+ size (bytevector-length block))))
                           (when (> size (narinfo-size info)) (error "NAR exceeds NarSize" file))
                           (loop size)))))))
      (close-port hashed)
      (close-port input)
      (close-port raw)
      (let ((statuses (map (lambda (pid) (cdr (waitpid pid))) pids)))
        (unless (and (= size (narinfo-size info))
                     (or (not file-size) (= file-size (stat:size (stat file))))
                     (bytevector=? expected (get-hash)) (every zero? statuses))
          (error "NAR hash/size/decompression mismatch" file))))))

(define (check-info file)
  (let* ((info (call-with-input-file file
                 (lambda (p) (read-narinfo p "https://substitutes.omaguix.org"))))
         (contents (and info (narinfo-contents info)))
         (index (and contents (string-contains contents "Signature:")))
         (signature (and info (narinfo-signature info))))
    (unless (and signature index) (error "missing/malformed signature" file))
    (let ((prefix (substring contents 0 index)))
      (for-each (lambda (field)
                  (unless (any (lambda (line) (string-prefix? field line))
                               (string-split prefix #\newline))
                    (error "mandatory field is not signed" field)))
                '("StorePath: " "NarHash: " "NarSize: " "References: "))
      (let ((hash (sha256 (string->utf8 prefix))))
        (signature-case (signature hash acl)
          (valid-signature #t)
          (else (error "unauthorized/invalid substitute signature" file)))))
    (unless (and (integer? (narinfo-size info)) (>= (narinfo-size info) 0)
                 (narinfo-hash->sha256 (narinfo-hash info))
                 (pair? (narinfo-uris info))
                 (= (length (narinfo-uris info)) (length (narinfo-compressions info)))
                 (= (length (narinfo-uris info)) (length (narinfo-file-sizes info)))
                 (string=? (basename file)
                           (string-append (store-path-hash-part (narinfo-path info)) ".narinfo")))
      (error "invalid narinfo hash/size/URL groups/filename" file))
    (for-each
     (lambda (uri compression file-size)
       (unless (member compression '("none" "gzip" "zstd")) (error "unsupported compression" compression))
       (let* ((relative (string-append "nar/" (if (string=? compression "none") ""
                                                 (string-append compression "/"))
                                      (basename (narinfo-path info))))
              (path (uri-path uri)))
         (unless (and (eq? (uri-scheme uri) 'https)
                      (equal? (uri-host uri) "substitutes.omaguix.org")
                      (not (uri-query uri)) (not (uri-fragment uri))
                      (member (uri-decode path) (list (string-append "/" relative)
                                                     (string-append "//" relative))))
           (error "unsafe substitute URL" uri))
         (check-nar info relative compression file-size)
         (format #t "~a\t~a\t~a~%" (narinfo-path info) relative
                 (string-drop path (if (string-prefix? "//" path) 2 1)))))
     (narinfo-uris info) (narinfo-compressions info) (narinfo-file-sizes info))))
(when (getenv "STATIC_NARINFO_LIST")
  (call-with-input-file (getenv "STATIC_NARINFO_LIST")
    (lambda (port)
      (let loop ((file (read-line port)))
        (unless (eof-object? file) (check-info file) (loop (read-line port)))))))

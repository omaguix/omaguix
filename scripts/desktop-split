#!/usr/bin/env bash
# Split the Roguix desktop's package closure for substitutes.omaguix.org, in
# the reference-system workflow. Only reads public narinfo URLs and the
# local store.
#
#   scripts/desktop-split [--guix-profile P] [--release-tag TAG] DIR
#
# Publishes package outputs and their closure, not the files generated for
# the one reference system (system, etc, udev rules, pam.d, shepherd
# services, ...), which no other machine requests.
#
# DIR holds:
#   closure.txt   `guix gc -R` of the built outputs
#   licenses.txt  "PATH NAME LICENCE,..." (the feed's licence collector):
#                 every package output the reference system lowers
# and receives:
#   packages.txt         licenses.txt's paths that are in closure.txt
#   package-closure.txt  `guix gc -R` of packages.txt: what is split
#   closure-status.txt   bordeaux and substitutes.omaguix.org narinfo
#                        status per item ("-": not asked)
#   vps-fetch.txt        items bordeaux serves: the VPS substitutes them
#   vps-has.txt          items substitutes.omaguix.org already serves: not exported
#   publish.txt          the rest, exported: the VPS has nowhere to fetch them
#   release-tag.txt      TAG when publish.txt is not empty, else empty
#
# P is the Guix profile the system was built with (try-omaguix
# docs/decisions/0007): it joins the package outputs, so P and its closure
# are split, checked and served like them.  P is made from G' alone before
# the system is built, so nothing in its closure was generated for this
# machine; the per-machine refusal skips it (G' patches core modules, so
# (guix self) nodes such as guix-system are not bordeaux's).
#
# It fails, publishing nothing, when a server gives no clear answer, when
# an item to publish is unfree ("Nonfree" or a licence Guix cannot name) or
# the Broadcom wl module, whose licence does not allow distributing it
# built, when an item to publish that is no package output looks
# per-machine (keys, host names, password hashes), or when an item to
# publish references a store path in none of the three lists.
set -euo pipefail
usage='usage: scripts/desktop-split [--guix-profile P] [--release-tag TAG] DIR'
profile='' tag=''
while [[ $# -gt 1 ]]; do
  case $1 in
    --guix-profile) profile=${2:?$usage}; shift 2 ;;
    --release-tag) tag=${2:?$usage}; shift 2 ;;
    *) echo "$usage" >&2; exit 1 ;;
  esac
done
dir=$(cd "${1:?$usage}" && pwd)
store_item='^/gnu/store/[0-9abcdfghijklmnpqrsvwxyz]{32}-[A-Za-z0-9+._?=-]+$'
if [[ -n $profile && ! $profile =~ $store_item ]]; then
  echo "desktop-split: the Guix profile $profile is not a store item" >&2
  exit 1
fi

awk '{ print $1 }' "$dir/licenses.txt" | sort -u |
  comm -12 - <(sort -u "$dir/closure.txt") > "$dir/packages.txt"
if [ ! -s "$dir/packages.txt" ]; then
  echo "desktop-split: no package output of licenses.txt is in closure.txt" >&2
  exit 1
fi
closure=$dir/package-closure.txt
{ cat "$dir/packages.txt"; [[ -z $profile ]] || echo "$profile"; } |
  xargs guix gc -R | sort -u > "$closure"
echo "desktop-split: $(wc -l < "$dir/packages.txt") package outputs," \
  "$(wc -l < "$closure") items in their closure," \
  "$(sort -u "$dir/closure.txt" | comm -23 - "$closure" | wc -l) system items left out"

# substitutes.omaguix.org is asked only about items bordeaux does not serve: its
# guix publish starts compressing any item it holds but has not baked.
narinfo_status() {
  local hash bordeaux vps=-
  hash=$(basename "$1" | cut -d- -f1)
  bordeaux=$(curl -s -o /dev/null -w '%{http_code}' "https://bordeaux.guix.gnu.org/$hash.narinfo")
  if [ "$bordeaux" != 200 ]; then
    vps=$(curl -s -o /dev/null -w '%{http_code}' "https://substitutes.omaguix.org/$hash.narinfo")
  fi
  printf '%s %s %s\n' "$bordeaux" "$vps" "$1"
}
export -f narinfo_status
# shellcheck disable=SC2016 # $1 is the inner bash's
xargs -P 16 -I{} bash -c 'narinfo_status "$1"' _ {} \
  < "$closure" | sort -k3 > "$dir/closure-status.txt"
if [ "$(wc -l < "$dir/closure-status.txt")" -ne "$(wc -l < "$closure")" ]; then
  echo "desktop-split: some narinfo checks did not finish" >&2
  exit 1
fi
unclear=$(awk '$1$2 !~ /^200-$|^404(200|404)$/' "$dir/closure-status.txt")
if [ -n "$unclear" ]; then
  echo "desktop-split: a server gave no clear answer:" >&2
  printf '%s\n' "$unclear" >&2
  exit 1
fi

awk '$1 == 200 { print $3 }' "$dir/closure-status.txt" > "$dir/vps-fetch.txt"
awk '$1 != 200 && $2 == 200 { print $3 }' "$dir/closure-status.txt" > "$dir/vps-has.txt"
awk '$1 != 200 && $2 != 200 { print $3 }' "$dir/closure-status.txt" > "$dir/publish.txt"

: > "$dir/profile-closure.txt"
[[ -z $profile ]] || guix gc -R "$profile" < /dev/null | sort -u > "$dir/profile-closure.txt"

fail=0
unfree=$(awk '$3 ~ /Nonfree|unknown/ { print $1 }' "$dir/licenses.txt" |
  grep -xF -f - "$dir/publish.txt" || true)
if [ -n "$unfree" ]; then
  echo "desktop-split: unfree items to publish:" >&2
  printf '%s\n' "$unfree" >&2
  fail=1
fi
# Package outputs are versioned and never match; this catches a generated
# per-machine file that a package output references.
per_machine='-(system|etc|profile|boot|initrd|grub\.cfg|grub-image\.png|activate|activate-service\.scm|shepherd(-[a-z0-9.-]+)?\.(scm|go)|shepherd\.conf|linux-module-database|sudoers|passwd|shadow|group|hosts|ssh-authorized-keys|authorized_keys|acl|signing-key[a-z.]*|wpa_supplicant[a-z.-]*)$'
while read -r item; do
  name=$(basename "$item" | cut -d- -f2-)
  # The package wl (wl-6.30.223.271), not wl-clipboard or other wl-* tools.
  if [[ $name =~ broadcom-sta|^wl(-[0-9]|$) ]]; then
    echo "desktop-split: Broadcom wl to publish: $item" >&2
    fail=1
  fi
  if [[ -$name =~ $per_machine ]] &&
    ! grep -qxF "$item" "$dir/packages.txt" "$dir/profile-closure.txt"; then
    echo "desktop-split: per-machine item to publish: $item" >&2
    fail=1
  fi
done < "$dir/publish.txt"
rm "$dir/profile-closure.txt"
[ "$fail" = 0 ] || exit 1

# The VPS imports publish.txt and must find every reference of it in the
# archive, in its store or on bordeaux.
sort -u "$dir/publish.txt" "$dir/vps-fetch.txt" "$dir/vps-has.txt" > "$dir/known.txt"
while read -r item; do
  missing=$(guix gc --references "$item" < /dev/null | sort -u | comm -23 - "$dir/known.txt")
  if [ -n "$missing" ]; then
    echo "desktop-split: $item references items in no list:" >&2
    printf '%s\n' "$missing" >&2
    fail=1
  fi
done < "$dir/publish.txt"
rm "$dir/known.txt"
[ "$fail" = 0 ] || exit 1

if [[ -s $dir/publish.txt && -z $tag ]]; then
  echo "desktop-split: items to publish but no --release-tag" >&2
  exit 1
fi
if [[ -s $dir/publish.txt ]]; then
  printf '%s\n' "$tag" > "$dir/release-tag.txt"
else
  : > "$dir/release-tag.txt"
fi

echo "publish: $(wc -l < "$dir/publish.txt")," \
  "VPS fetches: $(wc -l < "$dir/vps-fetch.txt"), VPS has: $(wc -l < "$dir/vps-has.txt")"
